# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/skillhub?retryWrites=true&w=majority

# JWT Authentication Secret (generate a long random string)
JWT_SECRET=your_super_secret_jwt_key_here_replace_in_production

# SMTP Email Configuration (for email verification)
# Gmail example: use an App Password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Skill Hub <your_email@gmail.com>"

# Your deployed frontend URL (used in verification email links)
FRONTEND_URL=https://your-app.vercel.app
